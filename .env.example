# OAuth配置示例文件
# 复制此文件为 .env 并填入真实的配置信息

# 115网盘OAuth配置
OAUTH_115_CLIENT_ID=your_115_client_id_here
OAUTH_115_CLIENT_SECRET=your_115_client_secret_here

# 百度网盘OAuth配置
OAUTH_BAIDU_CLIENT_ID=your_baidu_client_id_here
OAUTH_BAIDU_CLIENT_SECRET=your_baidu_client_secret_here

# 123云盘Open OAuth配置
OAUTH_123_CLIENT_ID=your_123_client_id_here
OAUTH_123_CLIENT_SECRET=your_123_client_secret_here

# OneDrive / Microsoft Graph OAuth配置
OAUTH_ONEDRIVE_CLIENT_ID=your_onedrive_client_id_here
OAUTH_ONEDRIVE_CLIENT_SECRET=your_onedrive_client_secret_here


# 服务器配置
EXTERNAL_URL=http://your-domain.com
INTERNAL_PORT=5288

# 统计页 / 统计 API 访问口令（Basic / Bearer / ?token= 均可）
# 默认 000000，请务必改成复杂密码
STATS_PASSWORD=
# 统计登录 Cookie 签名密钥（可选；不设置时用统计口令作为签名密钥）
STATS_SECRET=
